{
  "description": "Toasts and sounds through ai-notify when Codex asks for a permission or finishes its turn (see bin/ai-notify); herdr's session hook so herdr can resume Codex after a restart.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "ai-notify codex",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "ai-notify codex",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}