{
  "description": "Toasts and sounds through claude-notify when Codex asks for a permission or finishes its turn (see bin/claude-notify); herdr's session hook so herdr can resume Codex after a restart.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "claude-notify codex",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "claude-notify codex",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}