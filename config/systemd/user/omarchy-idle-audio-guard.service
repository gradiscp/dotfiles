[Unit]
Description=Keep Omarchy awake while a fullscreen video is playing
PartOf=graphical-session.target
After=graphical-session.target pipewire-pulse.service

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-idle-audio-guard
ExecStop=%h/.local/bin/omarchy-idle-audio-guard --release
Restart=always
RestartSec=5
# It only calls pactl, hyprctl, jq and omarchy-toggle-idle - no setuid needed.
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
