{
  // Omarchy menu overrides. A user entry REPLACES the stock one completely:
  // missing fields become defaults, so every override repeats the stock fields.
  //
  // Share: every entry ends in localsend, which is not installed. Hiding the
  // parent hides its children too; it comes back once localsend is installed.
  "trigger.share": {"icon":"","label":"Share","aliases":["share"],"when":"omarchy-cmd-present localsend"},
}
