      "tray": [
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "gradiscp.security"
        }
      ]
    },
    "position": "top"
  },
  "cloneSourceRestores": [],
