{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.clock",
          "format": "yyyy-MM-dd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "gradiscp.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "gradiscp.claude-status"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": false
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "cloneSourceRestores": [
    "gradiscp.lock",
    "gradiscp.idle",
    "gradiscp.notifications"
  ],
  "disabledPlugins": [
    "omarchy.lock",
    "omarchy.idle",
    "omarchy.notifications"
  ],
  "idle": {
    "lock": 420,
    "screensaver": 300
  },
  "plugins": [
    {
      "id": "gradiscp.lock"
    },
    {
      "id": "gradiscp.idle"
    },
    {
      "id": "gradiscp.closeconfirm"
    },
    {
      "id": "gradiscp.notifications"
    }
  ],
  "version": 1
}
