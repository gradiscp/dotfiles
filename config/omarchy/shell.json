          "items": [
            "StayAwake"
          ]
        }
      ],
      "centerBegin": [
        {
          "alwaysShow": true,
          "id": "omarchy.indicators",
          "items": [
            "Dnd"
          ]
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.media"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "gradiscp.workspaces"
        }
      ],
      "right": [
