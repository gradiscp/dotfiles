{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.media"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "gradiscp.workspaces"
        }
      ],
      "right": [
        {
          "id": "gradiscp.claude-status"
        },
        {
          "id": "omarchy.agents",
          "providers": {
            "claude": {
              "enabled": true
            },
            "codex": {
              "enabled": false
            },
            "fireworks": {
              "enabled": false
            }
          }
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.power",
          "showPercentage": false
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "cloneSourceRestores": [],
  "disabledPlugins": [],
  "idle": {
    "lock": 420,
    "screensaver": 300
  },
  "plugins": [
    {
      "id": "gradiscp.closeconfirm"
    }
  ],
  "version": 1
}
