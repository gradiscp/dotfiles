#!/bin/bash
# One look at every git repo below the current directory (or a given root):
# uncommitted changes, unpushed commits, branches without an upstream,
# stashes. Meant to be run from ~/Projects.
#
# It does NOT fetch: Claude has no key for GitHub and a fetch would prompt for
# the SSH passphrase. "unpushed" therefore means "not on origin as of your last
# fetch/pull" - run `git fetch` in a repo first if that matters.
#
# Usage: git-status-all [root]    (default: the current directory)

set -uo pipefail
root="${1:-$PWD}"

red=$'\e[31m' yellow=$'\e[33m' green=$'\e[32m' dim=$'\e[2m' reset=$'\e[0m'
open=0 total=0

while IFS= read -r gitdir; do
  repo=${gitdir%/.git}
  ((total++))
  notes=()

  n=$(git -C "$repo" status --porcelain 2>/dev/null | wc -l)
  ((n > 0)) && notes+=("${red}${n} uncommitted${reset}")

  while IFS=' ' read -r branch upstream; do
    if [[ -z $upstream ]]; then
      notes+=("${yellow}${branch}: no upstream${reset}")
    else
      ahead=$(git -C "$repo" rev-list --count "$upstream..$branch" 2>/dev/null)
      ((ahead > 0)) && notes+=("${yellow}${branch}: ${ahead} unpushed${reset}")
    fi
  done < <(git -C "$repo" for-each-ref --format='%(refname:short) %(upstream:short)' refs/heads)

  s=$(git -C "$repo" stash list 2>/dev/null | wc -l)
  ((s > 0)) && notes+=("${dim}${s} stash${reset}")

  name=${repo#"$root"/}
  if ((${#notes[@]} > 0)); then
    ((open++))
    printf '%s%s%s\n' "$red" "● " "$reset$name"
    printf '    %s\n' "${notes[@]}"
  else
    printf '%s✓%s %s%s%s\n' "$green" "$reset" "$dim" "$name" "$reset"
  fi
done < <(find "$root" -maxdepth 5 -type d -name .git 2>/dev/null | sort)

echo
echo "${dim}${total} repos, ${open} with something open (no fetch - unpushed = since your last fetch)${reset}"
