#!/bin/bash
# Run one git action over every repo below the current directory (or a given
# root). Meant to be run from ~/Projects.
#
#   git-all            status: uncommitted, unpushed, no-upstream, stashes
#   git-all fetch      git fetch --all --prune (drops remote branches deleted on origin)
#   git-all pull       git pull --ff-only on the current branch; dirty repos are skipped
#   git-all push       push every branch that has an upstream and is ahead of it;
#                      branches without upstream are only listed (push -u by hand)
#   git-all json       the status as one JSON array, for bin/ops-status
#
# Status and json never talk to the network. fetch/pull/push do; the per-login
# ssh-agent asks for each key's passphrase once (config/environment.d/).
#
# Usage: git-all [status|fetch|pull|push|json] [root]

set -uo pipefail
action="${1:-status}"
case $action in status|fetch|pull|push|json) ;; *) echo "usage: git-all [status|fetch|pull|push|json] [root]" >&2; exit 2 ;; esac
root="${2:-$PWD}"

red=$'\e[31m' yellow=$'\e[33m' green=$'\e[32m' dim=$'\e[2m' reset=$'\e[0m'
[[ -t 1 ]] || { red=''; yellow=''; green=''; dim=''; reset=''; }   # plain output when piped
open=0 total=0

# status lines for one repo, one per line, empty when clean
status_notes() {
  local repo=$1 n s branch upstream ahead
  n=$(git -C "$repo" status --porcelain 2>/dev/null | wc -l)
  ((n > 0)) && echo "${red}${n} uncommitted${reset}"
  while IFS=' ' read -r branch upstream; do
    if [[ -z $upstream ]]; then
      echo "${yellow}${branch}: no upstream${reset}"
    else
      ahead=$(git -C "$repo" rev-list --count "$upstream..$branch" 2>/dev/null)
      ((ahead > 0)) && echo "${yellow}${branch}: ${ahead} unpushed${reset}"
    fi
  done < <(git -C "$repo" for-each-ref --format='%(refname:short) %(upstream:short)' refs/heads)
  s=$(git -C "$repo" stash list 2>/dev/null | wc -l)
  ((s > 0)) && echo "${dim}${s} stash${reset}"
}

# One tab-separated line for a repo: name, path, current branch, then counts
# of uncommitted files, unpushed commits, branches without upstream, branches
# whose upstream is gone, stashes, and the commit time of the oldest unpushed
# commit (0 when there is none).
json_row() {
  local repo=$1 name=$2 branch upstream track t
  local dirty unpushed=0 no_upstream=0 gone=0 stash oldest=0
  dirty=$(git -C "$repo" status --porcelain 2>/dev/null | wc -l)
  # %1f (unit separator), not a tab: read would fold an empty field away.
  while IFS=$'\x1f' read -r branch upstream track; do
    if [[ -z $upstream ]]; then
      no_upstream=$((no_upstream + 1))
    elif [[ $track == *gone* ]]; then
      gone=$((gone + 1))
    elif [[ $track =~ ahead\ ([0-9]+) ]]; then
      unpushed=$((unpushed + BASH_REMATCH[1]))
      t=$(git -C "$repo" log --format=%ct "$upstream..$branch" 2>/dev/null | tail -n 1)
      [[ $t =~ ^[0-9]+$ ]] && ((oldest == 0 || t < oldest)) && oldest=$t
    fi
  done < <(git -C "$repo" for-each-ref --format='%(refname:short)%1f%(upstream:short)%1f%(upstream:track)' refs/heads)
  stash=$(git -C "$repo" stash list 2>/dev/null | wc -l)
  printf '%s\t%s\t%s\t%d\t%d\t%d\t%d\t%d\t%d\n' "$name" "$repo" \
    "$(git -C "$repo" branch --show-current 2>/dev/null)" \
    "$dirty" "$unpushed" "$no_upstream" "$gone" "$stash" "$oldest"
}

if [[ $action == json ]]; then
  while IFS= read -r gitdir; do
    json_row "${gitdir%/.git}" "$(basename "${gitdir%/.git}")"
  done < <(find "$root" -maxdepth 5 -type d -name .git 2>/dev/null | sort) |
    jq -Rn '[inputs | split("\t") | {
      name: .[0], path: .[1], branch: .[2],
      dirty: (.[3] | tonumber), unpushed: (.[4] | tonumber),
      noUpstream: (.[5] | tonumber), gone: (.[6] | tonumber),
      stash: (.[7] | tonumber), oldestUnpushed: (.[8] | tonumber)
    }]'
  exit
fi

# fetch / pull / push for one repo; prints result lines
act() {
  local repo=$1 out branch upstream ahead
  case $action in
  fetch)
    out=$(git -C "$repo" fetch --all --prune 2>&1) && echo "${green}fetched${reset}${out:+ $dim$(echo "$out" | grep -c ' - \[deleted\]') pruned$reset}" || echo "${red}fetch failed:${reset} ${out##*$'\n'}"
    ;;
  pull)
    if [[ -n $(git -C "$repo" status --porcelain 2>/dev/null) ]]; then
      echo "${yellow}skipped: uncommitted changes${reset}"; return
    fi
    out=$(git -C "$repo" pull --ff-only 2>&1) && echo "${green}${out##*$'\n'}${reset}" || echo "${red}pull failed:${reset} ${out##*$'\n'}"
    ;;
  push)
    while IFS=' ' read -r branch upstream remote remoteref; do
      if [[ -z $upstream ]]; then
        echo "${yellow}${branch}: no upstream - push by hand: git push -u origin ${branch}${reset}"; continue
      fi
      ahead=$(git -C "$repo" rev-list --count "$upstream..$branch" 2>/dev/null)
      ((ahead > 0)) || continue
      out=$(git -C "$repo" push "$remote" "refs/heads/$branch:$remoteref" 2>&1) && echo "${green}${branch}: pushed ${ahead}${reset}" || echo "${red}${branch}: push failed:${reset} ${out##*$'\n'}"
    done < <(git -C "$repo" for-each-ref --format='%(refname:short) %(upstream:short) %(upstream:remotename) %(upstream:remoteref)' refs/heads)
    ;;
  esac
}

while IFS= read -r gitdir; do
  repo=${gitdir%/.git}
  ((total++))
  name=${repo#"$root"/}
  if [[ $action == status ]]; then
    mapfile -t notes < <(status_notes "$repo")
  else
    mapfile -t notes < <(act "$repo")
  fi
  if ((${#notes[@]} > 0)); then
    ((open++))
    printf '%s● %s%s\n' "$red" "$reset" "$name"
    printf '    %s\n' "${notes[@]}"
  else
    printf '%s✓%s %s%s%s\n' "$green" "$reset" "$dim" "$name" "$reset"
  fi
done < <(find "$root" -maxdepth 5 -type d -name .git 2>/dev/null | sort)

echo
if [[ $action == status ]]; then
  echo "${dim}${total} repos, ${open} with something open (no fetch - unpushed = since your last fetch)${reset}"
else
  echo "${dim}${total} repos${reset}"
fi
