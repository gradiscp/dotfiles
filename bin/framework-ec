#!/bin/bash
# Root side of the gradiscp.framework bar plugin: sets the Framework EC's
# charge limit, charge rate and fingerprint LED, and keeps them in
# /etc/framework-ec.conf, which framework-ec.service applies again at boot and
# after resume (in case firmware resets them; not verified that it does).
# install.sh copies this script root-owned to /usr/local/bin; the plugin runs
# it through pkexec, so every change asks for the fingerprint or password.
#
#   framework-ec set charge-limit 50..100
#   framework-ec set charge-rate 0.1..0.9|1   (C rate; 1 = no limit)
#   framework-ec set fp-brightness 1..100    (the EC refuses 0)
#   framework-ec status                      what the EC reports now
#   framework-ec apply                       the saved values (the unit)
set -euo pipefail
export PATH=/usr/bin
umask 022

conf=/etc/framework-ec.conf
tool=/usr/bin/framework_tool

(( EUID == 0 )) || { echo "framework-ec: needs root (pkexec /usr/local/bin/framework-ec ...)" >&2; exit 1; }

valid() {
  case $1 in
    charge_limit) [[ $2 =~ ^[0-9]{2,3}$ ]] && (( 10#$2 >= 50 && 10#$2 <= 100 )) ;;
    charge_rate) [[ $2 =~ ^(0\.[1-9]|1|1\.0)$ ]] ;;
    fp_brightness) [[ $2 =~ ^[0-9]{1,3}$ ]] && (( 10#$2 >= 1 && 10#$2 <= 100 )) ;;
    *) return 1 ;;
  esac
}

# Sends one value to the EC. framework_tool's exit code does not reliably tell
# an EC refusal apart, so its "[ERROR]" lines count as failure too.
send() {
  local out
  case $1 in
    charge_limit) out=$("$tool" --charge-limit "$2" 2>&1) ;;
    charge_rate) out=$("$tool" --charge-rate-limit "$2" 2>&1) ;;
    fp_brightness) out=$("$tool" --fp-brightness "$2" 2>&1) ;;
  esac || { printf '%s\n' "$out" | grep -v SMBIOS >&2; return 1; }
  if [[ $out == *"[ERROR]"* ]]; then
    printf '%s\n' "$out" | grep -F '[ERROR]' >&2
    return 1
  fi
}

save() {
  local tmp
  tmp=$(mktemp /etc/.framework-ec.XXXXXX)
  {
    echo "# Framework EC settings, written by framework-ec (gradiscp.framework"
    echo "# bar plugin) and applied at boot and resume by framework-ec.service."
    if [[ -f $conf ]]; then grep -E '^[a-z_]+=' "$conf" | grep -v "^$1=" || true; fi
    printf '%s=%s\n' "$1" "$2"
  } >"$tmp"
  chmod 644 "$tmp"
  mv "$tmp" "$conf"
}

status() {
  local out
  out=$("$tool" --charge-limit 2>&1) || true
  [[ $out =~ Maximum\ ([0-9]+) ]] && echo "charge_limit=${BASH_REMATCH[1]}"
  out=$("$tool" --fp-brightness 2>&1) || true
  [[ $out =~ Brightness:\ ([0-9]+)% ]] && echo "fp_brightness=${BASH_REMATCH[1]}"
  return 0
}

apply() {
  local key value rc=0
  [[ -f $conf ]] || return 0
  while IFS='=' read -r key value; do
    [[ $key =~ ^[a-z_]+$ ]] || continue
    if ! valid "$key" "$value"; then
      echo "framework-ec: ignoring $key=$value" >&2
    elif ! send "$key" "$value"; then
      echo "framework-ec: $key=$value failed" >&2
      rc=1
    fi
  done <"$conf"
  return $rc
}

case ${1:-} in
  set)
    key=${2:-}
    key=${key//-/_}
    value=${3:-}
    valid "$key" "$value" || { echo "framework-ec: invalid: ${2:-} '$value'" >&2; exit 2; }
    send "$key" "$value"
    save "$key" "$value"
    ;;
  status) status ;;
  apply) apply ;;
  *) echo "usage: framework-ec set charge-limit|charge-rate|fp-brightness VALUE | status | apply" >&2; exit 2 ;;
esac
