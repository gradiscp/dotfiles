#!/bin/bash
# Find where the live system has drifted away from the dotfiles repo, repair
# what is safe to repair, and report the rest as a desktop notification.
#
# Why this exists: Omarchy's own tools replace symlinks with plain files when
# they write (omarchy-shell-config mv's a temp file over shell.json,
# omarchy-hyprland-monitor-scaling runs sed -i without --follow-symlinks).
# That bit this machine in 2026-09 and was only noticed by accident.
#
# Runs after every `omarchy update` (linked into
# ~/.config/omarchy/hooks/post-update.d/ by install.sh); run it by hand any time.
#
# Checks:
#   links     every `link` in install.sh points into the repo. A plain file
#             whose content equals the repo copy is re-linked (nothing lost);
#             one that differs is only reported, with which side is newer.
#   plugins   every plugin id in shell.json exists under ~/.config/omarchy/plugins
#   pacman    the stock-theme NoExtract (Tokyo Night excepted) is still in
#             /etc/pacman.conf, only tokyo-night is left under
#             /usr/share/omarchy/themes, and no package from the removal
#             list is installed again (remove-unwanted-apps.sh --check)
#
# Usage: omarchy-drift-check [--quiet]   (--quiet: no notification when clean)

set -uo pipefail

# This script is itself a link into the repo (~/.local/bin and the
# post-update hook dir), so the repo is two levels up from where it resolves.
REPO_DIR="${DOTFILES_DIR:-$(dirname "$(dirname "$(readlink -f "$0")")")}"
CONFIG_DIR="$HOME/.config"
STAMP="$(date +%s)"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-drift-check.log"
# Post-update log, kept across reboots (so not in XDG_RUNTIME_DIR); truncated
# at 100 KB so it cannot grow forever.
[[ -f $LOG && $(stat -c %s "$LOG" 2>/dev/null || echo 0) -gt 102400 ]] && : >"$LOG"
OMARCHY_BIN="${OMARCHY_PATH:-/usr/share/omarchy}/bin"
quiet=0; [[ ${1:-} == --quiet ]] && quiet=1

problems=()
repaired=()

say() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }
problem() { problems+=("$1"); say "PROBLEM $1"; }
fixed() { repaired+=("$1"); say "REPAIRED $1"; }

[[ -d $REPO_DIR ]] || { echo "dotfiles repo not found at $REPO_DIR" >&2; exit 2; }

# ---- links: parsed from install.sh so there is exactly one list --------------
# Each line is `link "<src>" "<dst>"` with $REPO_DIR / $CONFIG_DIR / $HOME
# inside; the variables are ours, so evaluating them is safe. install.sh's one
# loop (the hypr .lua files, `link "$f" ...`) is expanded here by hand.
check_link() {
  local src=$1 dst=$2
  if [[ -L $dst && $(readlink -f "$dst") == "$REPO_DIR"/* ]]; then
    return
  fi
  if [[ ! -e $dst ]]; then
    if mkdir -p "$(dirname "$dst")" && ln -sfn "$src" "$dst" 2>/dev/null; then
      fixed "created missing link $dst"
    else
      problem "missing and could not link: $dst"
    fi
    return
  fi
  # A plain file or directory in the way: safe to replace only if identical.
  # The link is built beside it and moved over it in one rename, so there is
  # no moment with nothing at $dst (the earlier mv-then-ln left the config
  # gone if ln failed).
  if diff -rq "$src" "$dst" >/dev/null 2>&1; then
    if [[ -d $dst && ! -L $dst ]]; then
      # rename(2) cannot put a symlink over a real directory; the content was
      # verified identical, so dropping the copy first loses nothing.
      if rm -rf "$dst" && ln -sfn "$src" "$dst"; then
        fixed "re-linked $dst (content was identical)"
      else
        problem "could not re-link $dst"
      fi
    elif ln -sfn "$src" "$dst.link.$STAMP" && mv -T "$dst.link.$STAMP" "$dst"; then
      fixed "re-linked $dst (content was identical)"
    else
      rm -f "$dst.link.$STAMP"
      problem "could not re-link $dst"
    fi
  else
    newer="repo"
    [[ $dst -nt $src ]] && newer="live"
    problem "$dst is a plain copy that DIFFERS from the repo ($newer side is newer) - merge by hand"
  fi
}
for f in "$REPO_DIR"/config/hypr/*.lua; do
  check_link "$f" "$CONFIG_DIR/hypr/$(basename "$f")"
done
while IFS= read -r line; do
  # shellcheck disable=SC2016  # literal: skip the loop line that uses "$f"
  [[ $line == *'"$f"'* ]] && continue
  # The eval below expands this repo's own install.sh, run by this user anyway;
  # still, an unattended hook must not run a command substitution from it.
  # shellcheck disable=SC2016  # literal patterns
  [[ $line == *'$('* || $line == *'`'* ]] && { problem "unsafe link line in install.sh: $line"; continue; }
  eval "set -- $line"
  check_link "$1" "$2"
done < <(grep -E '^\s*link "' "$REPO_DIR/install.sh" | sed -E 's/^\s*link //')

# ---- plugins referenced by shell.json ---------------------------------------
if [[ -f $CONFIG_DIR/omarchy/shell.json ]]; then
  while IFS= read -r id; do
    [[ $id == gradiscp.* ]] || continue
    [[ -e $CONFIG_DIR/omarchy/plugins/$id ]] || problem "shell.json lists plugin $id but ~/.config/omarchy/plugins/$id is missing"
  done < <(jq -r '[.plugins[]?.id, .bar.layout[]?[]?.id] | .[]' "$CONFIG_DIR/omarchy/shell.json" 2>/dev/null | sort -u)
fi

# ---- pacman NoExtract, stock themes, reinstalled packages ------------------
grep -qxF 'NoExtract   = usr/share/omarchy/themes/* !usr/share/omarchy/themes/tokyo-night/*' /etc/pacman.conf \
  || problem "NoExtract for stock themes (with the tokyo-night exception) is not in /etc/pacman.conf - re-run remove-unwanted-apps.sh"
# The reverse of the stock-theme rule: a NoExtract on the Plymouth/SDDM theme
# makes the next omarchy-settings upgrade DELETE the boot screen, leaving a
# bare-text LUKS prompt and a greeter-less logout (2026-09-16).
grep -qF 'usr/share/plymouth/themes/omarchy/*' /etc/pacman.conf && problem "harmful NoExtract for the Plymouth/SDDM theme is in /etc/pacman.conf - delete that line, then: sudo pacman -S omarchy-settings"
extra_themes=$(find /usr/share/omarchy/themes -mindepth 1 -maxdepth 1 -type d ! -name tokyo-night -printf '%f ' 2>/dev/null)
[[ -n $extra_themes ]] && problem "stock Omarchy themes are back in /usr/share/omarchy/themes ($extra_themes) - re-run remove-unwanted-apps.sh"
[[ -d /usr/share/omarchy/themes/tokyo-night ]] || problem "tokyo-night is missing from /usr/share/omarchy/themes - sudo pacman -S omarchy"
# A package removed on purpose can come back through any `pacman -S`, typed
# or clicked in Omarchy's Install menu (LibreOffice, 2026-09-24, unnoticed
# for three weeks - incidents repo).
reinstalled=$("$REPO_DIR/remove-unwanted-apps.sh" --check 2>/dev/null | tr '\n' ' ')
[[ -n $reinstalled ]] && problem "unwanted packages or launchers are back: ${reinstalled}- run remove-unwanted-apps.sh"
# The Brave policy is a root-owned copy, not a link; install.sh refreshes it.
if ! cmp -s "$REPO_DIR/config/brave/privacy.json" /etc/brave/policies/managed/privacy.json; then
  problem "/etc/brave/policies/managed/privacy.json differs from the repo - sudo install -Dm644 config/brave/privacy.json /etc/brave/policies/managed/privacy.json"
fi

# ---- report -----------------------------------------------------------------
say "run finished: ${#repaired[@]} repaired, ${#problems[@]} problems"
for r in "${repaired[@]}"; do echo "repaired: $r"; done
for p in "${problems[@]}"; do echo "PROBLEM: $p"; done

notify() { "$OMARCHY_BIN/omarchy-notification-send" "$@" >/dev/null 2>&1 || true; }
if (( ${#problems[@]} > 0 )); then
  notify -u critical -g $'\U000F0026' "Dotfiles-Drift: ${#problems[@]} Problem(e)" \
    "$(printf '%s\n' "${problems[@]}" | head -3)" --exec foot -e less "$LOG"
  exit 1
elif (( ${#repaired[@]} > 0 )); then
  notify -u normal -g $'\U000F0026' "Dotfiles: ${#repaired[@]} Link(s) repariert" "$(printf '%s\n' "${repaired[@]}" | head -3)"
elif (( quiet == 0 )); then
  notify -u low -g $'\U000F0026' "Dotfiles" "Alles im Reinen"
fi
exit 0
