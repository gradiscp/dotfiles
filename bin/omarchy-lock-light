#!/bin/bash
# Light lock (SUPER+L): same lock as SUPER+SHIFT+L, but the display is never
# blanked/turned off, and gradiscp.lock shows its minimal view (blurred
# screenshot + lock icon) instead of the normal lock screen with the clock.
# Both hinge on the flag file below; the lock itself is the stock command,
# so its keyboard-layout reset and screensaver cleanup stay in sync with
# Omarchy instead of being a hand-copied duplicate (which this was until
# 2026-09-21). The flag lives on tmpfs: a shell crash between lock and
# unlock cannot leave the next SUPER+SHIFT+L in light mode.

: "${XDG_RUNTIME_DIR:?omarchy-lock-light: XDG_RUNTIME_DIR unset}"
touch "$XDG_RUNTIME_DIR/omarchy-lock-no-blank"

exec omarchy-system-lock
