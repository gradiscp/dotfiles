#!/bin/bash
# Pop an Omarchy toast (top right, same popup as the low-battery warning)
# whenever Claude Code stops to ask for permission, and jump straight back to
# that exact terminal when it is clicked.
#
# Wired up in config/claude/settings.json as two hooks: PermissionRequest
# (fires as the dialog opens, so the toast is immediate) and Notification with
# matcher "permission_prompt" (the original; arrives later, so it is only a
# fallback - skipped when a PermissionRequest toast for the same terminal went
# up in the last 20s). A third hook, Stop, only plays the done sound (below).
# Two kinds of terminal:
#
# - Inside herdr: the hook inherits HERDR_PANE_ID from the pane Claude runs
#   in, so a click focuses herdr's window *and* that pane - no guessing which
#   of several agents is the one asking.
# - A plain terminal window (foot etc.): the hook walks up its own process
#   tree to the window that owns it, and a click focuses that window.
#   Out of reach: Claude over SSH (the hook runs on the other machine) and
#   inside tmux (the tmux server owns no window) - no toast for those.
#
# The toast is gone after 10s no matter what, or sooner once it has been
# dealt with: in herdr when the agent leaves the "blocked" state, in a plain
# terminal when that window gets focus. It is critical urgency for the
# battery-warning look, and Omarchy never expires critical toasts on its own,
# so a detached watcher takes it down. No toast at all when that terminal is
# already the one you are looking at.
#
# Because the toast does not wait around, `jump` exists for a keybind: the
# most recently blocked herdr agent, else the last plain terminal that asked
# and has not been visited since.
#
# Sounds: herdr's own two (request, done), played here instead of by herdr
# (config/herdr/config.toml silences herdr for Claude) so that they can be
# switched off at runtime without editing that linked repo file. The request
# sound goes with the prompt (also while toasts are muted), the done sound
# with Claude's Stop hook; neither when you are looking at that terminal,
# like herdr. install.sh fetches the files.
#
# `quiet` mutes the toasts (right-click on the gradiscp.claude-status bar
# widget, or the switch in its panel): the bar glyph still lights up and the
# sound still plays. `sound off` mutes the sounds. Both flags live on tmpfs,
# so a reboot turns everything back on.
#
# `status` feeds that widget's panel: one JSON document with every herdr
# agent (waiting ones first, with what they ask for), the plain terminal that
# asked, and the quiet flag. What a session asks
# for ("Braucht eine Genehmigung: Bash") is kept in <key>.ask next to the
# toast state and dropped by `count` once herdr no longer reports the pane
# blocked, so a prompt that arrived without a hook never shows a stale ask.
#
# Usage:
#   claude-notify                         reads Claude's hook JSON on stdin
#   claude-notify focus <pane>            click action, herdr pane
#   claude-notify focus-window <address>  click action, plain terminal
#   claude-notify jump                    keybind
#   claude-notify count                   bar widget poll
#   claude-notify status                  bar widget panel, JSON
#   claude-notify quiet [on|off|toggle]   mute toasts; prints on/off
#   claude-notify sound [on|off|toggle]   sounds on/off; prints on/off

set -uo pipefail

OMARCHY_BIN="${OMARCHY_PATH:-/usr/share/omarchy}/bin"
# The click action runs from the shell's environment, whose PATH need not
# include ~/.local/bin - so hand it an absolute path to this script.
SELF="$(realpath -s "$0")"
# Needs XDG_RUNTIME_DIR (always set under uwsm); no /tmp fallback. Exit 0 so
# a hook never blocks Claude.
[[ -n ${XDG_RUNTIME_DIR:-} ]] || { echo "claude-notify: XDG_RUNTIME_DIR unset" >&2; exit 0; }
RUN_DIR="$XDG_RUNTIME_DIR/claude-notify"
LAST_WINDOW="$RUN_DIR/last-window"
QUIET="$RUN_DIR/quiet"
SOUND_OFF="$RUN_DIR/sound-off"
SOUND_DIR="$HOME/.local/share/claude-notify/sounds"
mkdir -p "$RUN_DIR"
# Only these shapes ever reach a hyprctl dispatch or become a file name:
# a Hyprland window address, and a herdr pane id (w<N>:p<N> as observed in
# `herdr agent list`; not a documented contract).
valid_address() { [[ $1 =~ ^0x[0-9a-f]+$ ]]; }
valid_pane() { [[ $1 =~ ^w[0-9]+:p[0-9]+$ ]]; }
TOAST_MS=10000

now_ms() { date +%s%3N; }

# Every hook decision lands here, since a toast that does not appear is
# otherwise indistinguishable from a hook that never ran. tmpfs, gone on reboot.
log() {
  printf '%s %s\n' "$(date +%T)" "$*" >>"$RUN_DIR/log"
}

active_window() { hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty'; }

# Play <name>.mp3 (request or done) detached, so the hook returns at once.
play_sound() {
  [[ -e $SOUND_OFF || ! -f $SOUND_DIR/$1.mp3 ]] && return 0
  setsid -f paplay "$SOUND_DIR/$1.mp3" </dev/null >/dev/null 2>&1
}

# Address of the Hyprland window owned by <pid> or its nearest ancestor that
# owns one. Fails if the chain reaches init without finding a window.
window_of() {
  local pid=$1 address clients
  clients=$(hyprctl clients -j 2>/dev/null) || clients='[]'
  while [[ -n $pid && $pid -gt 1 ]]; do
    address=$(jq -r --argjson pid "$pid" \
      'first(.[] | select(.pid == $pid)).address // empty' <<<"$clients")
    [[ -n $address ]] && { echo "$address"; return 0; }
    pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
  done
  return 1
}

# herdr runs as a headless server plus a client; only the client sits in a
# terminal window (the server's chain ends at systemd and never finds one).
herdr_window() {
  local pid
  for pid in $(pgrep -x herdr); do
    window_of "$pid" && return 0
  done
  return 1
}

# Whether <pid> runs somewhere under a herdr process.
under_herdr() {
  local pid=$1
  while [[ -n $pid && $pid -gt 1 ]]; do
    [[ $(ps -o comm= -p "$pid") == herdr ]] && return 0
    pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
  done
  return 1
}

focus_window() {
  valid_address "$1" || return 1
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$1\" })" >/dev/null 2>&1 ||
    hyprctl dispatch focuswindow "address:$1" >/dev/null 2>&1
}

# Take down the toast recorded under <key> (a herdr pane id or window-<address>).
dismiss() {
  local headline
  headline=$(sed -n 2p "$RUN_DIR/$1" 2>/dev/null)
  [[ -n $headline ]] && "$OMARCHY_BIN/omarchy-shell" notifications dismiss "$headline" >/dev/null 2>&1
}

# Title of the Hyprland window <address>, without the spinner glyph Claude
# puts in front ("<glyph> <task>"). Fails when the window is gone.
window_title() {
  hyprctl clients -j 2>/dev/null |
    jq -er --arg a "$1" 'first(.[] | select(.address == $a)) | .title // ""' |
    sed 's/^[^[:alnum:]]* //'
}

# The plain terminal counts as visited: `jump` should not lead back to it.
forget_window() {
  [[ $(cat "$LAST_WINDOW" 2>/dev/null) == "$1" ]] && rm -f "$LAST_WINDOW"
  rm -f "$RUN_DIR/window-$1.ask"
}

focus_pane() {
  local pane=$1 address

  # Server-side focus first, so a client attaching below opens on this pane.
  herdr agent focus "$pane" >/dev/null 2>&1
  dismiss "$pane"

  if address=$(herdr_window); then
    focus_window "$address"
  else
    # No window attached to the session any more - open one.
    setsid -f "$OMARCHY_BIN/omarchy-launch-terminal-herdr" >/dev/null 2>&1
  fi
}

focus_plain() {
  dismiss "window-$1"
  forget_window "$1"
  focus_window "$1"
}

case ${1:-} in
focus)
  valid_pane "${2:?usage: claude-notify focus <pane>}" || exit 0
  focus_pane "$2"
  exit 0
  ;;
focus-window)
  valid_address "${2:?usage: claude-notify focus-window <address>}" || exit 0
  focus_plain "$2"
  exit 0
  ;;
count)
  # For the gradiscp.claude-status bar widget: herdr agents in "blocked", plus
  # the plain terminal that asked and has not been visited since. Only the
  # last plain terminal is remembered, so that side adds at most 1. Then a
  # line "quiet" while toasts are muted, and "silent" while sounds are off.
  blocked=$(herdr agent list 2>/dev/null |
    jq -r '.result.agents[]? | select(.agent_status == "blocked") | .pane_id' 2>/dev/null)
  n=0
  [[ -n $blocked ]] && n=$(wc -l <<<"$blocked")
  # A pane that is no longer blocked has had its question answered; its
  # recorded ask would otherwise resurface on the next prompt that comes
  # without a hook (a plan approval, a question from the agent).
  for ask in "$RUN_DIR"/w*:p*.ask; do
    [[ -f $ask ]] || continue
    key=${ask##*/}
    [[ $'\n'$blocked$'\n' == *$'\n'${key%.ask}$'\n'* ]] || rm -f "$ask"
  done
  if [[ -s $LAST_WINDOW ]]; then
    last=$(cat "$LAST_WINDOW")
    # Being in that window counts as a visit. The toast's watcher only looks
    # for 10s, so without this a prompt answered later kept the glyph lit.
    if [[ $(active_window) == "$last" ]]; then
      forget_window "$last"
    elif hyprctl clients -j 2>/dev/null |
      jq -e --arg a "$last" 'any(.[]; .address == $a)' >/dev/null; then
      n=$((n + 1))
    fi
  fi
  echo "$n"
  [[ -e $QUIET ]] && echo quiet
  [[ -e $SOUND_OFF ]] && echo silent
  exit 0
  ;;
status)
  # For the panel of the gradiscp.claude-status bar widget, polled only while
  # it is open: one jq pass over `herdr agent list`, the ask files and the
  # plain terminal, so a refresh is one fork of each tool. Session
  # titles come from Claude's terminal title and are untrusted text; the
  # panel renders them as plain text.
  agents=$(herdr agent list 2>/dev/null | jq -c '.result.agents // []' 2>/dev/null)
  asks=
  for ask in "$RUN_DIR"/*.ask; do
    [[ -f $ask ]] || continue
    key=${ask##*/}
    asks+="${key%.ask}	$(head -n 1 "$ask")"$'\n'
  done
  window=; wtitle=
  if [[ -s $LAST_WINDOW ]] && wtitle=$(window_title "$(cat "$LAST_WINDOW")"); then
    window=$(cat "$LAST_WINDOW")
  fi
  quiet=0; [[ -e $QUIET ]] && quiet=1
  sound=1; [[ -e $SOUND_OFF ]] && sound=0
  jq -n --argjson agents "${agents:-[]}" --arg asks "$asks" --argjson quiet "$quiet" \
    --argjson sound "$sound" --arg window "$window" --arg wtitle "${wtitle:-Terminal}" '
    def rank: {blocked: 0, working: 1, idle: 2, unknown: 3, done: 4}[.] // 5;
    ($asks | split("\n") | map(select(length > 0) | split("\t")
      | {key: .[0], asked_ms: ((.[1] // "0") | tonumber? // 0), ask: (.[2] // "")})
      | map({(.key): .}) | add // {}) as $ask
    | {
      quiet: ($quiet == 1),
      sound: ($sound == 1),
      sessions: ([
          $agents[] | select(.pane_id != null) | {
            kind: "pane", id: .pane_id, status: (.agent_status // "unknown"),
            title: (.terminal_title_stripped // .terminal_title // ""),
            project: ((.cwd // "") | split("/") | last // ""),
            focused: (.focused == true), seq: (.state_change_seq // 0)
          } + (if .agent_status == "blocked" then ($ask[.pane_id] // {}) | del(.key) else {} end)
        ] + (if $window == "" then [] else [{
            kind: "window", id: $window, status: "blocked", title: $wtitle,
            project: "", focused: false, seq: 0
          } + ($ask["window-" + $window] // {} | del(.key))] end)
        | sort_by([(.status | rank), -.seq]))
    }'
  exit 0
  ;;
quiet)
  case ${2:-} in
  on) : >"$QUIET" ;;
  off) rm -f "$QUIET" ;;
  toggle) if [[ -e $QUIET ]]; then rm -f "$QUIET"; else : >"$QUIET"; fi ;;
  esac
  [[ -e $QUIET ]] && echo on || echo off
  exit 0
  ;;
sound)
  case ${2:-} in
  on) rm -f "$SOUND_OFF" ;;
  off) : >"$SOUND_OFF" ;;
  toggle) if [[ -e $SOUND_OFF ]]; then rm -f "$SOUND_OFF"; else : >"$SOUND_OFF"; fi ;;
  esac
  [[ -e $SOUND_OFF ]] && echo off || echo on
  exit 0
  ;;
jump)
  pane=$(herdr agent list 2>/dev/null | jq -r '
    [.result.agents[] | select(.agent_status == "blocked")]
    | max_by(.state_change_seq) | .pane_id // empty')
  if [[ -n $pane ]] && valid_pane "$pane"; then
    focus_pane "$pane"
  elif [[ -s $LAST_WINDOW ]]; then
    focus_plain "$(cat "$LAST_WINDOW")"
  fi
  exit 0
  ;;
esac

input=$(cat)
event=$(jq -r '.hook_event_name // empty' <<<"$input")
message=$(jq -r '.message // empty' <<<"$input")
[[ $event == PermissionRequest ]] &&
  message="Braucht eine Genehmigung: $(jq -r '.tool_name // "Tool"' <<<"$input")"
# HERDR_PANE_ID alone proves little: a terminal window opened from a shell
# inside herdr inherits it too. Trust it only with herdr up the process tree.
pane=
[[ -n ${HERDR_PANE_ID:-} ]] && valid_pane "$HERDR_PANE_ID" && under_herdr "$$" && pane=$HERDR_PANE_ID

if [[ -n $pane ]]; then
  agent=$(herdr agent get "$pane" 2>/dev/null | jq -c '.result.agent // {}')
  window=$(herdr_window)
  key=$pane
  title=$(jq -r '.terminal_title_stripped // empty' <<<"$agent")
  # herdr's window being active is not enough - another tab may be showing.
  [[ $(jq -r '.focused' <<<"$agent") == true ]] && looking=1 || looking=0
  click=(focus "$pane")
else
  window=$(window_of "$$") || { log "skip: no local terminal window (SSH, tmux?)"; exit 0; }
  key="window-$window"
  title=$(window_title "$window")
  looking=1
  click=(focus-window "$window")
fi
[[ -n $title ]] || title=$(basename "$(jq -r '.cwd // empty' <<<"$input")")

looking_at_it() { ((looking)) && [[ -n $window && $(active_window) == "$window" ]]; }

# Claude finished its turn: only the done sound.
if [[ $event == Stop ]]; then
  if looking_at_it; then
    log "skip ($key, Stop): already looking at it"
  else
    log "done ($key): sound"
    play_sound "done"
  fi
  exit 0
fi

# The late Notification hook for a prompt PermissionRequest already announced.
# The marker is set before any exit below, so muted toasts do not let the
# fallback play the sound a second time.
marker="$RUN_DIR/$key.request"
stamp=$(cat "$marker" 2>/dev/null); [[ $stamp =~ ^[0-9]+$ ]] || stamp=0
if [[ $event == Notification && -f $marker ]] && (( $(now_ms) - stamp < 20000 )); then
  log "skip ($key): Notification after PermissionRequest"
  exit 0
fi
[[ $event == PermissionRequest ]] && now_ms >"$marker"

# What it asks for, shown in the widget's panel even when no toast goes up.
# A pane's file lives until `count` sees the pane unblocked, a plain
# terminal's until that window is visited (forget_window).
ask="$(now_ms)	${message//[$'\t\n']/ }"
[[ -n $pane ]] && echo "$ask" >"$RUN_DIR/$key.ask"

# Already looking at that very terminal: a toast or sound would only be noise.
if looking_at_it; then
  log "skip ($key): already looking at it"
  exit 0
fi

play_sound request

# The plain terminal that asked, for the bar glyph, the panel and `jump`.
if [[ -z $pane ]]; then
  rm -f "$RUN_DIR"/window-*.ask
  echo "$window" >"$LAST_WINDOW"
  echo "$ask" >"$RUN_DIR/$key.ask"
fi

# The headline doubles as the handle for dismissing the toast later, so it
# carries the terminal's title to tell two waiting sessions apart.
headline="Claude wartet${title:+: $title}"

if [[ -e $QUIET ]]; then
  log "quiet ($key, ${event:-?}): $headline"
  exit 0
fi

log "toast ($key, ${event:-?}): $headline"

# One state file per terminal: a token, so a watcher left over from an earlier
# prompt in the same place cannot take down this newer toast, and the headline
# for dismiss(). Written BEFORE the toast goes up: a click that lands right
# after omarchy-notification-send returns already runs dismiss() and must
# find this headline, not the previous prompt's.
token="$$.$(now_ms)"
printf '%s\n%s\n' "$token" "$headline" >"$RUN_DIR/$key"

"$OMARCHY_BIN/omarchy-notification-send" --app-name "Claude Code" \
  -g $'\U000F06A9' -u critical "$headline" "${message:-Braucht eine Genehmigung}" \
  --exec "$SELF" "${click[@]}" >/dev/null 2>&1

# Fully detached, so the hook returns at once and Claude is not held up.
(
  deadline=$(($(now_ms) + TOAST_MS))
  if [[ -n $pane ]]; then
    # herdr reads the agent state off the terminal, so right when the hook
    # fires it may not have registered "blocked" yet - wait for that first,
    # otherwise the second wait would return immediately.
    if herdr agent wait "$pane" --until blocked --timeout "$TOAST_MS"; then
      left=$((deadline - $(now_ms)))
      ((left > 0)) && herdr agent wait "$pane" \
        --until idle --until working --until "done" --until unknown --timeout "$left"
    fi
  else
    # No agent state outside herdr; going to the window is the best signal.
    while (($(now_ms) < deadline)); do
      if [[ $(active_window) == "$window" ]]; then
        forget_window "$window"
        break
      fi
      sleep 0.5
    done
  fi
  [[ $(sed -n 1p "$RUN_DIR/$key" 2>/dev/null) == "$token" ]] && dismiss "$key"
) </dev/null >/dev/null 2>&1 &
disown

exit 0
