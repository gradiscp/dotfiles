#!/bin/bash
# Data side of the gradiscp.framework bar plugin; needs no root.
#
#   framework-panel status [--firmware]
#       One JSON object: battery, charger, EC temperatures and fan, firmware,
#       expansion cards, the EC settings framework-ec keeps in
#       /etc/framework-ec.conf, and the laptop panel's refresh rate.
#       --firmware adds fwupd's pending updates from its local metadata (no
#       download; `omarchy update firmware` fetches fresh metadata).
#   framework-panel refresh-rate auto|60|120
#       Refresh rate of the laptop panel. auto follows the power profile (60 Hz
#       outside "performance"); config/hypr/monitors.lua reads the choice.
set -uo pipefail

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/framework
rate_file=$state_dir/refresh-rate
ec_conf=/etc/framework-ec.conf

# First line of a file; empty when it is missing or unreadable.
line() { local v=""; { read -r v <"$1"; } 2>/dev/null; printf '%s' "$v"; }
# Leading integer of a file ("9000mV" -> 9000), or null.
int() {
  local v
  v=$(line "$1")
  v=${v%%[!0-9-]*}
  if [[ $v =~ ^-?[0-9]+$ ]]; then printf '%s' "$v"; else printf null; fi
}

battery() {
  local b
  for b in /sys/class/power_supply/BAT*; do
    [[ -d $b ]] || continue
    jq -cn --arg status "$(line "$b/status")" \
      --argjson percent "$(int "$b/capacity")" \
      --argjson cycles "$(int "$b/cycle_count")" \
      --argjson power "$(int "$b/power_now")" \
      --argjson current "$(int "$b/current_now")" \
      --argjson voltage "$(int "$b/voltage_now")" \
      --argjson full "$(int "$b/charge_full")" \
      --argjson design "$(int "$b/charge_full_design")" \
      '{status: $status, percent: $percent, cycles: $cycles,
        watts: (if $power != null then $power / 1e6
                elif $current != null and $voltage != null then ($current | fabs) * $voltage / 1e12
                else null end | if . == null then null else (. * 10 | round) / 10 end),
        health: (if $full != null and ($design // 0) > 0 then ($full * 100 / $design | round) else null end)}'
    return
  done
  echo null
}

# The USB-C source powering the laptop: what it offers (its PD source
# capabilities) and what it delivers now. ucsi-source-psy-USBC000:00N is
# typec port N-1.
charger() {
  local psy n caps pdo v a
  for psy in /sys/class/power_supply/ucsi-source-psy-*; do
    [[ $(line "$psy/online") == 1 ]] || continue
    n=${psy##*:}
    caps=/sys/class/typec/port$((10#$n - 1))-partner/usb_power_delivery/source-capabilities
    for pdo in "$caps"/*; do
      [[ -d $pdo ]] || continue
      v=$(int "$pdo/voltage")
      [[ $v == null ]] && v=$(int "$pdo/maximum_voltage")
      a=$(int "$pdo/maximum_current")
      [[ $v != null && $a != null ]] && printf '{"mv":%s,"ma":%s}\n' "$v" "$a"
    done | jq -cs --argjson v "$(int "$psy/voltage_now")" --argjson a "$(int "$psy/current_now")" \
      '{online: true,
        offers: map({volts: (.mv / 100 | round / 10), amps: (.ma / 10 | round / 100)}),
        max_w: (map(.mv * .ma / 1e6) | max // null | if . == null then null else round end),
        now_w: (if $v != null and $a != null then ($v * $a / 1e12 * 10 | round) / 10 else null end)}'
    return
  done
  if [[ $(line /sys/class/power_supply/ACAD/online) == 1 ]]; then echo '{"online":true}'; else echo '{"online":false}'; fi
}

ec_hwmon() {
  local h
  for h in /sys/class/hwmon/hwmon*; do
    [[ $(line "$h/name") == cros_ec ]] && { printf '%s' "$h"; return 0; }
  done
  return 1
}

# EC sensors with the EC's own warning level ("max"). The labels name the
# sensor chip and where its probe sits.
temps() {
  local h t base label
  h=$(ec_hwmon) || { echo '[]'; return; }
  for t in "$h"/temp*_input; do
    [[ -e $t ]] || continue
    base=${t%_input}
    label=$(line "${base}_label")
    case $label in
      cpu@*) label=CPU ;;
      cpu_*) label="Near CPU" ;;
      ddr_*) label=Memory ;;
      local_*) label=Mainboard ;;
    esac
    jq -cn --arg name "$label" --argjson mc "$(int "$t")" --argjson max "$(int "${base}_max")" \
      '{name: $name, c: (if $mc == null then null else ($mc / 1000 | round) end),
        max: (if $max == null then null else ($max / 1000 | round) end)}'
  done | jq -cs .
}

fan() {
  local h
  h=$(ec_hwmon) || { echo null; return; }
  int "$h/fan1_input"
}

firmware() {
  local ec="" l
  while read -r l; do
    [[ $l == "RW version:"* ]] && ec=${l#RW version:}
  done </sys/class/chromeos/cros_ec/version 2>/dev/null
  jq -cn --arg product "$(line /sys/class/dmi/id/product_name)" \
    --arg bios "$(line /sys/class/dmi/id/bios_version)" --arg ec "${ec// /}" \
    '{product: $product, bios: $bios, ec: $ec}'
}

# fwupd from its local metadata: devices with an update, and when the LVFS
# metadata was last downloaded (null: never, so "no updates" means nothing).
fwupd() {
  local updates checked
  command -v fwupdmgr >/dev/null || { echo null; return; }
  updates=$(timeout 30 fwupdmgr get-updates --json 2>/dev/null |
    jq -c '[.Devices[]? | {name: .Name, version: .Version, update: (.Releases[0].Version // null)}]' 2>/dev/null)
  checked=$(timeout 10 fwupdmgr get-remotes --json 2>/dev/null |
    jq -c '[.Remotes[]? | select(.Id == "lvfs") | .Mtime // empty] | first // null' 2>/dev/null)
  jq -cn --argjson updates "${updates:-[]}" --argjson checked "${checked:-null}" \
    '{updates: $updates, checked: $checked}'
}

# Framework's expansion cards that show up on USB (DisplayPort, HDMI, storage);
# the USB-C and USB-A cards are passive and invisible.
cards() {
  local d name
  for d in /sys/bus/usb/devices/*; do
    [[ $(line "$d/idVendor") == 32ac ]] || continue
    name=$(line "$d/product")
    [[ $name == *"Expansion Card"* ]] && jq -cn --arg name "$name" '{name: $name}'
  done | jq -cs .
}

# Only values framework-ec itself would accept; anything else counts as unset.
ec_settings() {
  local key value limit=null rate=null fp=null
  if [[ -r $ec_conf ]]; then
    while IFS='=' read -r key value; do
      case $key in
        charge_limit) [[ $value =~ ^[0-9]{2,3}$ ]] && limit=$((10#$value)) ;;
        charge_rate) [[ $value =~ ^(0\.[1-9]|1|1\.0)$ ]] && rate="\"$value\"" ;;
        fp_brightness) [[ $value =~ ^[0-9]{1,3}$ ]] && fp=$((10#$value)) ;;
      esac
    done <"$ec_conf"
  fi
  jq -cn --argjson helper "$([[ -x /usr/local/bin/framework-ec ]] && echo true || echo false)" \
    --argjson limit "$limit" --argjson rate "$rate" --argjson fp "$fp" \
    '{helper: $helper, charge_limit: $limit, charge_rate: $rate, fp_brightness: $fp}'
}

display() {
  local choice
  choice=$(line "$rate_file")
  [[ $choice =~ ^(auto|60|120)$ ]] || choice=auto
  hyprctl -j monitors 2>/dev/null | jq -c --arg choice "$choice" \
    --arg profile "$(line /sys/firmware/acpi/platform_profile)" \
    '(map(select(.name == "eDP-1")) | first) as $m
     | {choice: $choice, profile: $profile, on: ($m != null),
        hz: (if $m == null then null else ($m.refreshRate | round) end)}' 2>/dev/null ||
    jq -cn --arg choice "$choice" '{choice: $choice, profile: "", on: false, hz: null}'
}

status() {
  local fw=null
  [[ ${1:-} == --firmware ]] && fw=$(fwupd)
  jq -cn --argjson battery "$(battery)" --argjson charger "$(charger)" \
    --argjson temps "$(temps)" --argjson fan "$(fan)" \
    --argjson firmware "$(firmware)" --argjson fwupd "$fw" \
    --argjson cards "$(cards)" --argjson ec "$(ec_settings)" \
    --argjson display "$(display)" \
    '{battery: $battery, charger: $charger, temps: $temps, fan_rpm: $fan,
      firmware: $firmware, fwupd: $fwupd, cards: $cards, ec: $ec, display: $display}'
}

set_rate() {
  [[ ${1:-} =~ ^(auto|60|120)$ ]] || { echo "usage: framework-panel refresh-rate auto|60|120" >&2; exit 2; }
  mkdir -p "$state_dir"
  printf '%s\n' "$1" >"$rate_file"
  hyprctl reload >/dev/null
}

case ${1:-} in
  status) status "${2:-}" ;;
  refresh-rate) set_rate "${2:-}" ;;
  *) echo "usage: framework-panel status [--firmware] | refresh-rate auto|60|120" >&2; exit 2 ;;
esac
