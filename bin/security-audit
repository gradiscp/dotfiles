#!/bin/bash
# security-audit - the security checks from CHEATSHEET.md, one or all, in the
# background with a toast at the end.
#
#   security-audit start <check> [scope]   run in the background (what the
#                                          bar widget does); toast when done
#   security-audit <check> [scope]         the same here, in this terminal
#   security-audit stop                    cancel the background run
#   security-audit report [file]           a report (default: the newest) in a
#                                          floating terminal
#   security-audit status                  last results as JSON (for the widget)
#
# Checks and their scopes (the first one is the default):
#   packages  arch-audit: installed packages with a known vulnerability.
#             fixable   lists the ones an update already fixes
#             all       also lists the ones without a fix yet
#             Only the fixable ones count as findings either way.
#   projects  osv-scanner: lockfiles and installed language packages against
#             osv.dev. Sends package names and versions, no code. Git-ignored
#             paths (node_modules, target) are skipped, except with everything.
#             projects    ~/Projects
#             home        all of ~ (also tools installed there, e.g. by mise)
#             images      all of ~ plus every tagged local Docker image
#             everything  the whole computer as for viruses computer (also
#                         language packages bundled under /opt and /usr),
#                         git-ignored paths too, plus every Docker image
#   viruses   clamscan. Reports only, never deletes (false alarms).
#             downloads ~/Downloads and mounted USB sticks
#             home      all of ~ and USB sticks
#             computer  everything this user can read: / without /proc,
#                       /sys, /dev, /run and the btrfs snapshots, plus USB
#                       sticks. Not as root on purpose: the scanner parses
#                       untrusted files, and root-only files are few (they
#                       are counted as unreadable).
#   all       quick     packages fixable, projects projects, viruses downloads
#             full      packages all, projects everything, viruses computer
#
# A background run is the transient user unit security-audit.service at idle
# CPU and I/O priority: it never slows the desktop, and only one runs at a time
# (clamscan alone takes about 1 GB of RAM); a run in a terminal takes the same
# lock. The running check, each check's last result and the list of reports
# are kept in $XDG_STATE_HOME/security-audit/state.json (read by the
# gradiscp.security widget). Each run's output is a report in reports/ next to
# it, named <date>_<time>-<check>-<scope>.log; the newest 20 are kept, and
# last.log points at the newest. Exit status 1 means a check could not run,
# not that it found something.
# jq filters and hints for the user are single-quoted on purpose; the check_*
# functions are called by name; `finished` is read in the EXIT trap.
# shellcheck disable=SC2016,SC2329,SC2034
set -uo pipefail

SELF=$(readlink -f "$0")
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/security-audit
STATE=$STATE_DIR/state.json
REPORTS=$STATE_DIR/reports
LAST=$STATE_DIR/last.log
KEEP=20
LOCK=${XDG_RUNTIME_DIR:-/tmp}/security-audit.lock
UNIT=security-audit.service
PROJECTS=$HOME/Projects
GLYPH=$'\uf132'

bold=$'\e[1m' dim=$'\e[2m' red=$'\e[31m' green=$'\e[32m' off=$'\e[0m'

usage() {
  sed -n '5,10p' "$SELF" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

valid() {
  case "$1:$2" in
    packages:fixable | packages:all) ;;
    projects:projects | projects:home | projects:images | projects:everything) ;;
    viruses:downloads | viruses:home | viruses:computer) ;;
    all:quick | all:full) ;;
    *) return 1 ;;
  esac
}

default_scope() {
  case $1 in
    packages) echo fixable ;;
    projects) echo projects ;;
    viruses) echo downloads ;;
    all) echo quick ;;
  esac
}

label() {
  case $1 in
    packages) echo Pakete ;;
    projects) echo Projekte ;;
    viruses) echo Viren ;;
    all) echo "Alles" ;;
  esac
}

tool() {
  case $1 in
    packages) echo arch-audit ;;
    projects) echo osv-scanner ;;
    viruses) echo clamscan ;;
  esac
}

toast() {
  omarchy-notification-send -g "$GLYPH" "$@" >/dev/null 2>&1
}

# Rewrites the state file with a jq filter; only the lock holder writes.
state_set() {
  local current
  mkdir -p "$STATE_DIR"
  current=$(cat "$STATE" 2>/dev/null)
  jq "$@" <<<"${current:-"{}"}" >"$STATE.tmp" && mv "$STATE.tmp" "$STATE"
}

# record <check> <scope> <findings, -1 = could not run> <summary>
record() {
  state_set --arg c "$1" --arg s "$2" --argjson n "$3" --arg m "$4" --argjson t "$(date +%s)" \
    '.checks[$c] = {time: $t, scope: $s, findings: $n, summary: $m}'
}

heading() {
  printf '\n%s%s%s %s(%s)%s\n' "$bold" "$(label "$1")" "$off" "$dim" "$2" "$off"
}

usb_sticks() {
  local dir
  for dir in /run/media/"$USER"/*/; do
    [[ -d $dir ]] && echo "${dir%/}"
  done
}

# The top-level directories of the whole computer, one by one: excluding /run
# would also exclude the USB sticks below it, and the /bin -> usr/bin style
# links would scan /usr twice.
system_dirs() {
  local dir
  for dir in /*; do
    [[ -L $dir || ! -d $dir ]] && continue
    case $dir in /proc | /sys | /dev | /run | /.snapshots) continue ;; esac
    echo "$dir"
  done
}

check_packages() {
  local scope=$1 fixable all n rest
  heading packages "arch-audit, alle installierten Pakete"
  if ! fixable=$(arch-audit -u 2>&1); then
    printf '%s\n' "$fixable"
    record packages "$scope" -1 "konnte nicht laufen"
    return 1
  fi
  all=$(arch-audit 2>/dev/null)
  n=$(grep -c . <<<"$fixable")
  rest=$(($(grep -c . <<<"$all") - n))
  if ((n > 0)); then
    printf '%s%s%s\n' "$red" "$fixable" "$off"
    echo "Ein Update behebt sie: omarchy update"
  else
    printf '%sKeine Lücke, für die es schon ein Update gibt.%s\n' "$green" "$off"
  fi
  if [[ $scope == all ]] && ((rest > 0)); then
    printf '\nAlle bekannten Lücken, auch ohne Fix bisher:\n%s%s%s\n' "$dim" "$all" "$off"
  elif ((rest > 0)); then
    printf '%s%d weitere ohne Fix bisher (Option "Alle" zeigt sie).%s\n' "$dim" "$rest" "$off"
  fi
  if ((n > 0)); then
    record packages "$scope" "$n" "$n mit Update"
  else
    record packages "$scope" 0 "nichts zu tun"
  fi
  return 0
}

# Prints the affected packages of an osv-scanner JSON report, grouped under
# their file; paths relative to $2 if given, else with ~ for the home directory.
osv_table() {
  jq -r --arg root "$2" --arg home "$HOME" --arg red "$red" --arg off "$off" '
    [.results[] | .source.path as $path | .packages[] | select((.groups | length) > 0)
      | {path: $path, line: "\(.package.name) \(.package.version)\t\(.groups | length) Lücke(n), max. \(([.groups[].max_severity | tonumber?] | max) // "?")"}]
    | group_by(.path)[]
    | (.[0].path | if $root != "" then ltrimstr($root)
        elif startswith($home) then "~" + ltrimstr($home) else . end) as $file
    | "  \($file)", (unique_by(.line)[] | "    \($red)\(.line | sub("\t"; "\($off)  "))")
  ' "$1"
}

osv_count() {
  jq '[.results[].packages[] | select((.groups | length) > 0)] | length' "$1"
}

check_projects() {
  local scope=$1 json=$STATE_DIR/projects.json err=$STATE_DIR/projects.err
  local code n=0 in_images=0 image ijson cnt targets=() flags=() strip="" what
  # shellcheck disable=SC2088  # "~" here is text for the report, not a path
  case $scope in
    projects) targets=("$PROJECTS") strip="$PROJECTS/" what="~/Projects" ;;
    home) targets=("$HOME") what="~" ;;
    images) targets=("$HOME") what="~ und Docker-Images" ;;
    everything)
      mapfile -t targets < <(system_dirs)
      flags=(--no-ignore)
      what="ganzer Rechner, auch git-ignorierte Ordner, und Docker-Images"
      ;;
  esac
  heading projects "osv-scanner, $what"
  echo "Schickt Paketnamen und Versionen an osv.dev, keinen Code."
  osv-scanner scan source -r "${flags[@]}" --format json --output-file "$json" "${targets[@]}" >/dev/null 2>"$err"
  code=$?
  case $code in
    0 | 1)
      n=$(osv_count "$json")
      if ((n > 0)); then
        osv_table "$json" "$strip"
      else
        printf '%sKeine bekannte Lücke in den Abhängigkeiten.%s\n' "$green" "$off"
      fi
      ;;
    128) echo "Keine Lockfiles gefunden." ;;
    *)
      tail -n 5 "$err"
      record projects "$scope" -1 "konnte nicht laufen"
      return 1
      ;;
  esac

  if [[ $scope == images || $scope == everything ]]; then
    if ! docker info >/dev/null 2>&1; then
      echo "Docker läuft nicht, die Images sind übersprungen."
    else
      printf '\n%sDocker-Images%s (Paket-Details: osv-scanner scan image <Image>)\n' "$bold" "$off"
      while read -r image; do
        ijson=$STATE_DIR/image.json
        # </dev/null: the scanner must not eat the image list on stdin.
        osv-scanner scan image --format json --output-file "$ijson" "$image" </dev/null >/dev/null 2>"$err"
        code=$?
        if ((code > 1)); then
          printf '  %s: konnte nicht geprüft werden\n' "$image"
          continue
        fi
        cnt=$(osv_count "$ijson")
        in_images=$((in_images + cnt))
        if ((cnt > 0)); then
          printf '  %s%s: %d Paket(e) mit Lücke%s\n' "$red" "$image" "$cnt" "$off"
        else
          printf '  %s%s: keine bekannte Lücke%s\n' "$green" "$image" "$off"
        fi
      done < <(docker image ls --format '{{.Repository}}:{{.Tag}}' | grep -v '<none>' | sort -u)
      rm -f "$STATE_DIR/image.json"
    fi
  fi

  n=$((n + in_images))
  if ((n > 0)); then
    record projects "$scope" "$n" "$n Paket(e) mit Lücke$( ((in_images > 0)) && echo ", $in_images in Images")"
  else
    record projects "$scope" 0 "keine bekannte Lücke"
  fi
  return 0
}

check_viruses() {
  local scope=$1 targets=() out=$STATE_DIR/viruses.out err=$STATE_DIR/viruses.err n unreadable
  case $scope in
    downloads) [[ -d $HOME/Downloads ]] && targets+=("$HOME/Downloads") ;;
    home) targets+=("$HOME") ;;
    computer) mapfile -t targets < <(system_dirs) ;;
  esac
  mapfile -t -O "${#targets[@]}" targets < <(usb_sticks)
  heading viruses "clamscan: ${targets[*]/#$HOME/\~}"
  if ((${#targets[@]} == 0)); then
    echo "Nichts zu prüfen."
    record viruses "$scope" 0 "nichts zu prüfen"
    return 0
  fi
  echo "Lädt zuerst die Signaturen, das dauert einen Moment."
  clamscan -r -i "${targets[@]}" 2>"$err" | tee "$out"
  n=$(sed -n 's/^Infected files: //p' "$out")
  unreadable=$(grep -c . "$err")
  if [[ ! $n =~ ^[0-9]+$ ]]; then
    tail -n 5 "$err"
    record viruses "$scope" -1 "konnte nicht laufen"
    return 1
  fi
  ((unreadable > 0)) && printf '%s%d Dateien oder Ordner nicht lesbar (meist nur für root).%s\n' "$dim" "$unreadable" "$off"
  if ((n > 0)); then
    printf '%sNichts gelöscht. In Quarantäne verschieben: clamscan -r -i --move=$HOME/quarantine <Pfad>%s\n' "$red" "$off"
    record viruses "$scope" "$n" "$n Fund(e)"
  else
    record viruses "$scope" 0 "nichts gefunden"
  fi
  return 0
}

# history_add <status: done|failed|aborted> <findings or null>: puts this run
# first in the state's report list and deletes reports beyond the newest
# $KEEP (the names sort by time).
history_add() {
  local files excess
  state_set --arg f "$run_report" --argjson t "$run_started" --arg c "$run_check" \
    --arg s "$run_scope" --arg st "$1" --argjson n "$2" --argjson keep "$KEEP" \
    '.history = ([{file: $f, time: $t, check: $c, scope: $s, status: $st, found: $n}] + (.history // []))[:$keep]'
  files=("$REPORTS"/*.log)
  excess=$((${#files[@]} - KEEP))
  ((excess > 0)) && rm -f -- "${files[@]:0:excess}"
}

run() {
  local plan item failed=0 found=0 line n headline
  local summary=()
  # Globals, not locals: the EXIT trap reads them.
  run_check=$1 run_scope=$2
  mkdir -p "$REPORTS"
  exec 9>"$LOCK"
  if ! flock -n 9; then
    echo "Ein Sicherheits-Check läuft schon." >&2
    exit 1
  fi
  run_started=$(date +%s)
  run_report=$(date -d "@$run_started" +%Y-%m-%d_%H%M%S)-$run_check-$run_scope.log
  ln -sfn "reports/$run_report" "$LAST"
  exec > >(tee "$REPORTS/$run_report") 2>&1

  finished=0
  # Cancelled or the terminal closed: no "running" left behind in the widget,
  # and the report so far stays in the list.
  trap 'state_set ".running = null"; ((finished)) || { history_add aborted null; toast "Sicherheits-Check abgebrochen"; }' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  state_set --arg c "$run_check" --arg s "$run_scope" --argjson t "$run_started" \
    '.running = {check: $c, scope: $s, since: $t}'

  if [[ $run_check == all && $run_scope == full ]]; then
    plan=(packages:all projects:everything viruses:computer)
  elif [[ $run_check == all ]]; then
    plan=(packages:fixable projects:projects viruses:downloads)
  else
    plan=("$run_check:$run_scope")
  fi
  printf '%sSicherheits-Check%s %s (%s), %s\n' "$bold" "$off" "$(label "$run_check")" "$run_scope" "$(date -d "@$run_started" '+%d.%m.%Y %H:%M')"
  for item in "${plan[@]}"; do
    state_set --arg p "${item%%:*}" '.running.part = $p'
    "check_${item%%:*}" "${item#*:}" || failed=1
  done

  printf '\n%sErgebnis%s\n' "$bold" "$off"
  for item in "${plan[@]}"; do
    item=${item%%:*}
    line=$(jq -r --arg c "$item" '.checks[$c].summary // "?"' "$STATE")
    n=$(jq -r --arg c "$item" '.checks[$c].findings // 0' "$STATE")
    ((n > 0)) && found=$((found + n))
    printf '  %-9s %-12s %s\n' "$(label "$item")" "$(tool "$item")" "$line"
    summary+=("$(label "$item") ($(tool "$item")): $line")
  done

  if ((failed)); then
    headline="Sicherheits-Check: nicht alles lief"
    history_add failed "$found"
  elif ((found > 0)); then
    headline="Sicherheits-Check: $found Fund(e)"
    history_add "done" "$found"
  else
    headline="Sicherheits-Check: alles sauber"
    history_add "done" 0
  fi
  finished=1
  toast -u normal "$headline" "$(printf '%s\n' "${summary[@]}" "Klick öffnet den Bericht.")" --exec "$SELF" report "$run_report"
  exit "$failed"
}

case ${1:-} in
  status)
    cat "$STATE" 2>/dev/null || echo '{}'
    ;;
  start)
    check=${2:-}
    scope=${3:-$(default_scope "$check")}
    valid "$check" "$scope" || usage
    if systemctl --user -q is-active "$UNIT" || ! flock -n "$LOCK" true; then
      toast "Sicherheits-Check läuft schon"
      exit 0
    fi
    systemd-run --user --unit="$UNIT" --collect --quiet \
      -p Nice=19 -p IOSchedulingClass=idle -p CPUSchedulingPolicy=idle \
      -p StandardOutput=null -p StandardError=null \
      "$SELF" "$check" "$scope" || exit 1
    toast -t 4000 "Sicherheits-Check läuft im Hintergrund" "$(label "$check"). Ein Toast kommt, wenn er fertig ist."
    ;;
  stop)
    systemctl --user stop "$UNIT" 2>/dev/null
    ;;
  report)
    # Only a plain name from reports/: it comes from a click in the panel.
    if [[ -z ${2:-} ]]; then
      path=$LAST
    elif [[ $2 =~ ^[0-9A-Za-z_-]+\.log$ ]]; then
      path=$REPORTS/$2
    else
      usage
    fi
    if [[ ! -s $path ]]; then
      toast "Bericht nicht gefunden" "Aufgehoben werden die letzten $KEEP."
      exit 0
    fi
    exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title="Sicherheits-Bericht" -e less -R "$path"
    ;;
  packages | projects | viruses | all)
    scope=${2:-$(default_scope "$1")}
    valid "$1" "$scope" || usage
    run "$1" "$scope"
    ;;
  *) usage ;;
esac
